    <PackageReference Include="Microsoft.VisualStudio.ProjectSystem" Version="17.9.380" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Transitive via the VS SDK; ExcludeAssets does not flow, so pin it here to keep it out of the VSIX. -->
    <PackageReference Include="System.Text.Encodings.Web" Version="9.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.12.1606" PrivateAssets="all" />
  </ItemGroup>
