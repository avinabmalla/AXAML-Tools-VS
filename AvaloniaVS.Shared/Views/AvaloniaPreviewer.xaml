<UserControl
    x:Class="AvaloniaVS.Views.AvaloniaPreviewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    mc:Ignorable="d">
    <Grid x:Name="rootGrid">
        <ScrollViewer
            x:Name="previewScroller"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="previewGrid"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                UseLayoutRounding="True">
                <!-- The artboard: the rendered view on a soft shadow, as in the WPF designer. For a
                     Window, a title bar and border frame it (SetWindowChrome). -->
                <Border x:Name="windowFrame"
                        BorderThickness="0"
                        BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.MainWindowActiveDefaultBorderBrushKey}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.35" Color="Black" />
                    </Border.Effect>
                    <DockPanel>
                        <Grid x:Name="titleBar"
                              DockPanel.Dock="Top"
                              Height="30"
                              Visibility="Collapsed"
                              Background="{DynamicResource {x:Static vsui:EnvironmentColors.MainWindowActiveCaptionBrushKey}}"
                              TextElement.Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.MainWindowActiveCaptionTextBrushKey}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="windowTitle"
                                       Margin="12,0,8,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- Minimize, maximize, close (Segoe MDL2 Assets glyphs). -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="minimizeButton" Width="46" TextAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE921;" />
                                <TextBlock x:Name="maximizeButton" Width="46" TextAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE922;" />
                                <TextBlock Width="46" TextAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE8BB;" />
                            </StackPanel>
                        </Grid>
                        <Image
                            Name="preview"
                            Width="100"
                            Height="100"
                            MouseDown="Preview_MouseDown"
                            MouseMove="Preview_MouseMove"
                            MouseUp="Preview_MouseUp" />
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>

    <Border Name="error"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#80808080"
            Visibility="Collapsed">

      <StackPanel Background="{DynamicResource VsBrush.ToolWindowBackground}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
          <Grid Margin="0,0,7,0">
            <Ellipse
                Width="22"
                Height="22"
                Fill="#f55762" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="ExtraBold"
                Foreground="{DynamicResource VsBrush.WindowText}"
                Text="!" />
          </Grid>

          <TextBlock
            Name="errorHeading"
            HorizontalAlignment="Center"
            FontSize="18" />
        </StackPanel>

        <TextBlock
        Name="errorMessage"
        Margin="20,10,20,0"
        HorizontalAlignment="Center"
        TextWrapping="Wrap" />
        <StackPanel Margin="0,15,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
          <Button
            Name="buildButton"
            Padding="7,5,7,5"
            Visibility="Collapsed"
            Content="Build" />
          <Button
            Name="restartButton"
            Margin="8,0,0,0"
            Padding="7,5,7,5"
            Visibility="Collapsed"
            Content="Restart previewer" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Markup errors don't hide the preview: the last good frame stays visible under this banner. -->
    <Border Name="markupError"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Margin="8"
            Padding="8,6"
            CornerRadius="3"
            BorderThickness="1"
            BorderBrush="#f55762"
            Background="{DynamicResource VsBrush.InfoBackground}"
            Visibility="Collapsed">
      <DockPanel>
        <Grid DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Top">
          <Ellipse Width="16" Height="16" Fill="#f55762" />
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontWeight="ExtraBold" Foreground="White" Text="!" />
        </Grid>
        <TextBlock Name="markupErrorLocation"
                   DockPanel.Dock="Right"
                   Margin="8,0,0,0"
                   VerticalAlignment="Top">
          <Hyperlink Name="markupErrorLink">
            <Run Name="markupErrorLinkText" />
          </Hyperlink>
        </TextBlock>
        <TextBlock Name="markupErrorMessage"
                   Foreground="{DynamicResource VsBrush.InfoText}"
                   TextWrapping="Wrap" />
      </DockPanel>
    </Border>
    </Grid>
</UserControl>
